# All values are optional. Copy to .env and fill in what you have.

# Stage-2 AI relevance classification. If unset, the pipeline runs with
# rule-based classification only (docs/architecture.md §6) — this is a
# supported mode, not a degraded fallback.
ANTHROPIC_API_KEY=

# Required only by adapters that call Open States (docs/source-inventory.md §2).
OPENSTATES_API_KEY=

# Required only by adapters that call api.congress.gov.
CONGRESS_API_KEY=

# Defaults to a local SQLite file if unset.
DATABASE_URL=

# Overrides the default descriptive User-Agent sent on every HTTP request.
DFG_USER_AGENT=

DFG_HTTP_TIMEOUT_SECONDS=
DFG_HTTP_MAX_RETRIES=
